{
    "name": "AAWS - AI Agent Web Scraper",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },

    "postCreateCommand": "bash install/install_all.sh",

    "forwardPorts": [8000, 6080],
    "portsAttributes": {
        "8000": {
            "label": "Agent Server (FastAPI / Chainlit)",
            "onAutoForward": "notify"
        },
        "6080": {
            "label": "noVNC (Browser Visualization)",
            "onAutoForward": "notify"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.debugpy"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "editor.formatOnSave": true,
                "files.trimTrailingWhitespace": true
            }
        }
    }
}
