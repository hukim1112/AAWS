# 이 파일명은 .env로 저장되어야 합니다.
# Project Configuration
PROJECT_ROOT=/workspaces/codespaces-jupyter/AAWS

# 가상 디스플레이(noVNC) 번호를 지정합니다
DISPLAY=":1" # VNC 서버를 쓰는 경우에 주석해제
# 이 설정이 있어야 GUI 브라우저가 가상 화면(:1)에 나타납니다.
# VNC 서버를 쓰는 경우에 주석해제하세요.

# API Keys
OPENAI_API_KEY="your-api-key"
GOOGLE_API_KEY="your-api-key"
TAVILY_API_KEY="your-api-key"
LANGSMITH_API_KEY="your-api-key"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Vertex AI Settings (GOOGLE_API_KEY 대신 Vertex AI 사용 시)
# MODEL_PROVIDER="google_vertexai"
VERTEX_PROJECT="your-gcp-project-id" # 또는 GOOGLE_CLOUD_PROJECT / GCP_PROJECT
VERTEX_LOCATION="us-central1"        # 또는 GOOGLE_CLOUD_LOCATION (기본값: global)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service_account.json"

