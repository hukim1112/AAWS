{
  "goal": "http://quotes.toscrape.com 1~3페이지 인용구(text, author, tags) 데이터 수집",
  "output_schema": {
    "text": "string (인용구 본문 내용)",
    "author": "string (인용구 저자명)",
    "tags": "list[string] (인용구 관련 태그 목록)"
  },
  "data_sources": [
    {
      "description": "인용구 목록 웹페이지 (1~3페이지)",
      "method": "css_selectors",
      "details": {
        "container": "div.quote",
        "fields": {
          "text": "span.text",
          "author": "small.author",
          "tags": "div.tags a.tag"
        }
      }
    }
  ],
  "navigation": "URL 패턴: http://quotes.toscrape.com/page/{page}/ (page: 1~3)",
  "concerns": "정적 SSR 페이지로 차단 요소 없음. 요청 간 매너 딜레이 적용."
}